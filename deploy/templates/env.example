# ~/.config/dsh-assistant/env —— systemd 的 EnvironmentFile（600）
#
# 占位符模式：保持 TELEGRAM_BOT_TOKEN 为占位值时，
# channel-telegram 使用本地占位符传输（$DSH_HOME/channels/telegram/sim/inbox.jsonl）。
# 真实接入时把它换成 BotFather 给的 token，并务必设置 TELEGRAM_OWNER_ID。
TELEGRAM_BOT_TOKEN=placeholder
TELEGRAM_OWNER_ID=0
# DeepSeek API key（模型调用用）；没有就用 dsh 自己的凭据库，留空即可。
DEEPSEEK_API_KEY=
# DSH 文件写入策略：工作区可写；需要扩大权限时通过聊天审批。
# 完整访问需部署者显式改为 danger-full-access。
DSH_PERMISSION_MODE=workspace-write
